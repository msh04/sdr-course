    minoutbuf: '0'
    maxoutbuf: '0'
    label: Manual RF gain (dB); AGC off
    value: '0'
    start: '0'
    stop: '73'
    step: '1'
    widget: counter_slider
    rangeType: float
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    gui_hint: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 578
    - 118
    rotation: 0
    state: enabled
- name: f1
