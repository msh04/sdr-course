- name: pluto_source
  id: iio_pluto_source
  parameters:
    type: fc32
    uri: ''
    frequency: center_freq
    samplerate: samp_rate
    buffer_size: '32768'
    quadrature: 'True'
    rfdc: 'True'
    bbdc: 'True'
    gain1: '''manual'''
    manual_gain1: gain
    len_tag_key: packet_len
    filter_source: '''Auto'''
    filter: ''
    fpass: '0'
    fstop: '0'
    bandwidth: '1500000'
