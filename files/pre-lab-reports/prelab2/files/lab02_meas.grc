options:
  parameters:
    author: SDR Lab
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ADALM-PLUTO receive-only preparation. 800 MHz is a prelab assumption.
      Hardware not tested.
    copyright: ''
    description: ADALM-PLUTO with IIO source; manual gain, AGC off; assigned team
      gain not announced
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: lab02_meas
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Lab02 - ADALM-PLUTO receive-only measurements
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_0
  id: import
  parameters:
    alias: ''
    comment: ''
    affinity: ''
    minoutbuf: '0'
    maxoutbuf: '0'
