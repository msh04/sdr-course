  id: variable
  parameters:
    comment: ''
    value: '7.0'
  states:
    coordinate:
    - 500
    - 1300
    rotation: 0
    state: enabled
- name: a_pad
  id: variable
  parameters:
    comment: ''
    value: '0.5'
  states:
    coordinate:
    - 500
    - 1400
    rotation: 0
    state: enabled
- name: tx_atten_safe
  id: variable
  parameters:
    comment: ''
    value: max(tx_atten, 30.0 if mode == 1 else 18.0)
  states:
    coordinate:
    - 500
    - 1500
    rotation: 0
    state: enabled
- name: display_tx_atten
  id: variable_qtgui_label
  parameters:
    comment: ''
    label: 'Applied TX attenuation (dB): '
    type: real
    value: tx_atten_safe
    formatter: 'lambda x: "%.2f" % x'
    gui_hint: ''
  states:
    coordinate:
    - 760
    - 1600
    rotation: 0
    state: enabled
- name: p_tone_est
  id: variable_qtgui_label
  parameters:
    comment: ''
    label: 'Estimated input power per tone (dBm): '
    type: real
    value: (p_max + 20*math.log10(a_tone/(2 if mode == 3 else 1)) - tx_atten_safe - a_pad) if (a_tone > 0 and mode
      >= 2) else float('-inf')
    formatter: 'lambda x: "%.2f" % x'
    gui_hint: ''
  states:
    coordinate:
    - 760
    - 1700
    rotation: 0
    state: enabled
- name: enr_est
  id: variable_qtgui_label
  parameters:
    comment: ''
    label: 'Estimated ENR (dB): '
    type: real
    value: (p_max + 20*math.log10(a_noise) - 10*math.log10(samp_rate) - a_pad + 174 - tx_atten_safe) if (a_noise
      > 0 and mode == 1) else float('-inf')
    formatter: 'lambda x: "%.2f" % x'
    gui_hint: ''
  states:
    coordinate:
    - 760
    - 1800
    rotation: 0
    state: enabled
